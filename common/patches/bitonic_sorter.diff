diff --git a/test/tb_bitonic_sort.v b/test/tb_bitonic_sort.v
new file mode 100644
index 0000000..ecdaf72
--- /dev/null
+++ b/test/tb_bitonic_sort.v
@@ -0,0 +1,57 @@
+// Self-checking TB for mcjtag/bitonic_sort. Streams 128 vectors back-to-back
+// and compares each pipelined output to a software insertion sort. $fatal
+// on mismatch; hangs caught externally by tb_timeout_s.
+`timescale 1ns/1ps
+
+module testbench;
+    localparam DW = 16, N = 32, LAT = 15, NVECS = 128;
+    localparam TOTAL = NVECS + LAT + 2;
+
+    reg clk = 0; always #5 clk = ~clk;
+    reg  [DW*N-1:0] data_in;
+    wire [DW*N-1:0] data_out;
+
+    bitonic_sort #(.DATA_WIDTH(DW), .CHAN_NUM(N)) dut (
+        .clk(clk), .data_in(data_in), .data_out(data_out));
+
+    function automatic [DW*N-1:0] sort_bus(input [DW*N-1:0] bus);
+        reg [DW-1:0] a [0:N-1]; reg [DW-1:0] t; integer i, j;
+        begin
+            for (i = 0; i < N; i = i + 1) a[i] = bus[DW*i +: DW];
+            for (i = 1; i < N; i = i + 1) begin
+                t = a[i]; j = i;
+                while (j > 0 && a[j-1] > t) begin a[j] = a[j-1]; j = j - 1; end
+                a[j] = t;
+            end
+            for (i = 0; i < N; i = i + 1) sort_bus[DW*i +: DW] = a[i];
+        end
+    endfunction
+
+    reg [DW*N-1:0] stim_q [0:NVECS-1];
+    reg [DW*N-1:0] obs_q  [0:TOTAL-1];
+    integer cycle = 0, v, k;
+    reg started = 0;
+
+    initial begin
+        // Assign in initial (not declaration init) so iverilog's `always @(*)`
+        // in the comparators wakes up -- otherwise pipeline stages stay X.
+        data_in = {DW*N{1'b0}};
+        for (v = 0; v < NVECS; v = v + 1)
+            for (k = 0; k < N; k = k + 1)
+                stim_q[v][DW*k +: DW] = (v < 2) ? {DW{v[0]}} : $random;
+        @(posedge clk); @(posedge clk); started = 1'b1;
+        wait (cycle >= TOTAL);
+        for (v = 0; v < NVECS; v = v + 1)
+            if (obs_q[v + LAT + 1] !== sort_bus(stim_q[v]))
+                $fatal(1, "BITONIC_FAIL vec=%0d got=%h exp=%h",
+                       v, obs_q[v + LAT + 1], sort_bus(stim_q[v]));
+        $display("BITONIC_PASS (%0d vectors)", NVECS);
+        $finish;
+    end
+
+    always @(posedge clk) if (started && cycle < TOTAL) begin
+        obs_q[cycle] <= data_out;
+        data_in <= (cycle < NVECS) ? stim_q[cycle] : {DW*N{1'b0}};
+        cycle <= cycle + 1;
+    end
+endmodule
