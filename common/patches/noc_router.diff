diff --git a/src/rtl/router/router_synth_wrap.sv b/src/rtl/router/router_synth_wrap.sv
new file mode 100644
index 0000000..0a09156
--- /dev/null
+++ b/src/rtl/router/router_synth_wrap.sv
@@ -0,0 +1,68 @@
+// Synthesis wrapper for `router`. yosys-slang refuses to elaborate top-level
+// SV `interface` ports (and chokes on hierarchical interface refs through
+// generate blocks in the original `mesh`), so we present a router whose
+// boundary is plain `logic`. The wrapper is the synth top; the original
+// `router` is untouched and still used by the TB.
+
+import noc_params::*;
+
+module router_synth_wrap #(
+    parameter BUFFER_SIZE = 8,
+    parameter X_CURRENT = MESH_SIZE_X/2,
+    parameter Y_CURRENT = MESH_SIZE_Y/2
+)(
+    input  logic clk,
+    input  logic rst,
+
+    output flit_t                                up_data    [PORT_NUM-1:0],
+    output logic                                up_valid   [PORT_NUM-1:0],
+    input  logic [VC_NUM-1:0]                   up_on_off  [PORT_NUM-1:0],
+    input  logic [VC_NUM-1:0]                   up_alloc   [PORT_NUM-1:0],
+
+    input  flit_t                               dn_data    [PORT_NUM-1:0],
+    input  logic                                dn_valid   [PORT_NUM-1:0],
+    output logic [VC_NUM-1:0]                   dn_on_off  [PORT_NUM-1:0],
+    output logic [VC_NUM-1:0]                   dn_alloc   [PORT_NUM-1:0],
+
+    output logic [VC_NUM-1:0]                   error_o    [PORT_NUM-1:0]
+);
+
+    router2router up_if [PORT_NUM-1:0] ();
+    router2router dn_if [PORT_NUM-1:0] ();
+
+    genvar p;
+    generate
+        for (p = 0; p < PORT_NUM; p++) begin : g_port
+            assign up_data[p]              = up_if[p].data;
+            assign up_valid[p]             = up_if[p].is_valid;
+            assign up_if[p].is_on_off      = up_on_off[p];
+            assign up_if[p].is_allocatable = up_alloc[p];
+
+            assign dn_if[p].data           = dn_data[p];
+            assign dn_if[p].is_valid       = dn_valid[p];
+            assign dn_on_off[p]            = dn_if[p].is_on_off;
+            assign dn_alloc[p]             = dn_if[p].is_allocatable;
+        end
+    endgenerate
+
+    router #(
+        .BUFFER_SIZE(BUFFER_SIZE),
+        .X_CURRENT(X_CURRENT),
+        .Y_CURRENT(Y_CURRENT)
+    ) u_router (
+        .clk(clk),
+        .rst(rst),
+        .router_if_local_up   (up_if[LOCAL]),
+        .router_if_north_up   (up_if[NORTH]),
+        .router_if_south_up   (up_if[SOUTH]),
+        .router_if_west_up    (up_if[WEST]),
+        .router_if_east_up    (up_if[EAST]),
+        .router_if_local_down (dn_if[LOCAL]),
+        .router_if_north_down (dn_if[NORTH]),
+        .router_if_south_down (dn_if[SOUTH]),
+        .router_if_west_down  (dn_if[WEST]),
+        .router_if_east_down  (dn_if[EAST]),
+        .error_o(error_o)
+    );
+
+endmodule
