diff --git a/sim/fft_128_tc/stim.v b/sim/fft_128_tc/stim.v
index 25a3b02..f9bf4c1 100644
--- a/sim/fft_128_tc/stim.v
+++ b/sim/fft_128_tc/stim.v
@@ -1,7 +1,18 @@
 //----------------------------------------------------------------------
 //	Test Stimuli
 //----------------------------------------------------------------------
+//	Beyond the upstream input4/input5 vectors (which compare bit-exactly
+//	against committed *_golden.txt snapshots), we drive two structural
+//	impulse tests. Mathematically the DFT of a Kronecker delta is a
+//	constant across all N bins, so the FFT output for input = (4000, 0)
+//	at bin 0 and zero elsewhere must be exactly (0080, 0000) at every
+//	bin (the 1/N = 1/128 scaling is what the R22SDF pipeline applies).
+//	The imaginary-impulse variant catches Re/Im swap and imag-path bugs.
+//	A failing bin emits R22SDF_IMPULSE_FAIL / R22SDF_IMAG_IMPULSE_FAIL;
+//	clean runs print the matching _PASS line which the run command greps.
 initial begin : STIM
+	integer	k;
+	integer	imp_fail;
 	wait (reset == 1);
 	wait (reset == 0);
 	repeat(10) @(posedge clock);
@@ -13,6 +24,10 @@ initial begin : STIM
 		//	@(posedge clock);
 			LoadInputData("input5.txt");
 			GenerateInputWave;
+			LoadInputData("input_impulse.txt");
+			GenerateInputWave;
+			LoadInputData("input_imag_impulse.txt");
+			GenerateInputWave;
 		end
 		begin
 			wait (do_en == 1);
@@ -22,6 +37,34 @@ initial begin : STIM
 			wait (do_en == 1);
 			repeat(N) @(posedge clock);
 			SaveOutputData("output5.txt");
+
+			@(negedge clock);
+			wait (do_en == 1);
+			repeat(N) @(posedge clock);
+			SaveOutputData("output_impulse.txt");
+			imp_fail = 0;
+			for (k = 0; k < N; k = k + 1) begin
+				if (omem[2*k] !== 16'h0080 || omem[2*k+1] !== 16'h0000) begin
+					$display("R22SDF_IMPULSE_FAIL k=%0d Re=%h Im=%h (want 0080 0000)",
+						k, omem[2*k], omem[2*k+1]);
+					imp_fail = imp_fail + 1;
+				end
+			end
+			if (imp_fail == 0) $display("R22SDF_IMPULSE_PASS");
+
+			@(negedge clock);
+			wait (do_en == 1);
+			repeat(N) @(posedge clock);
+			SaveOutputData("output_imag_impulse.txt");
+			imp_fail = 0;
+			for (k = 0; k < N; k = k + 1) begin
+				if (omem[2*k] !== 16'h0000 || omem[2*k+1] !== 16'h0080) begin
+					$display("R22SDF_IMAG_IMPULSE_FAIL k=%0d Re=%h Im=%h (want 0000 0080)",
+						k, omem[2*k], omem[2*k+1]);
+					imp_fail = imp_fail + 1;
+				end
+			end
+			if (imp_fail == 0) $display("R22SDF_IMAG_IMPULSE_PASS");
 		end
 	join
 
@@ -29,7 +72,7 @@ initial begin : STIM
 	$finish;
 end
 initial begin : TIMEOUT
-	repeat(1000) #20;	//  1000 Clock Cycle Time
+	repeat(4000) #20;	//  4000 Clock Cycle Time (4 back-to-back FFTs)
 	$display("[FAILED] Simulation timed out.");
 	$finish;
 end
