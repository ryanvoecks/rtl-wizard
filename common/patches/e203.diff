+    wire [AW-1:0] addr_eff   = {AW{1'b0}};
+    wire [AW-1:0] addr_r_eff = {AW{1'b0}};
+`else
+    wire [AW-1:0] addr_eff   = addr;
+    wire [AW-1:0] addr_r_eff = addr_r;
+`endif
 
 
     genvar i;
