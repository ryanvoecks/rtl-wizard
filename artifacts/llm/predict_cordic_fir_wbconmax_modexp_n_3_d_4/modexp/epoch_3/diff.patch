+  // Section 1: bits [15:8] – two parallel additions
+  wire [8:0] s1_nc = {1'b0, a[15:8]} + {1'b0, b[15:8]};
+  wire [8:0] s1_c  = {1'b0, a[15:8]} + {1'b0, b[15:8]} + 9'd1;
+
+  // Section 2: bits [23:16] – two parallel additions
+  wire [8:0] s2_nc = {1'b0, a[23:16]} + {1'b0, b[23:16]};
+  wire [8:0] s2_c  = {1'b0, a[23:16]} + {1'b0, b[23:16]} + 9'd1;
+
+  // Section 3: bits [31:24] – two parallel additions
+  wire [8:0] s3_nc = {1'b0, a[31:24]} + {1'b0, b[31:24]};
+  wire [8:0] s3_c  = {1'b0, a[31:24]} + {1'b0, b[31:24]} + 9'd1;
+
+  // Carry chain: serial but only through fast 2:1 muxes
+  wire c0 = s0[8];
+  wire c1 = c0 ? s1_c[8] : s1_nc[8];
+  wire c2 = c1 ? s2_c[8] : s2_nc[8];
