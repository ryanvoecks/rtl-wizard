   //----------------------------------------------------------------
+  // w_precomp_logic
+  //
+  // Pre-computes the W value needed for the NEXT round so it
+  // arrives at T1 already registered, removing one adder level
+  // from the critical path w_mem->w_new->T1->a_reg.
+  //
+  // For w_ctr < 16 (rounds 0-15), the window hasn't slid yet so
+  // the next expansion (W[16]) = w_new = w_mem[0]+σ0(w_mem[1])+
+  //   w_mem[9]+σ1(w_mem[14]).
+  // For w_ctr >= 16, after the slide the next window position 0
+  // maps to current position 1, giving:
+  //   w_mem[1]+σ0(w_mem[2])+w_mem[10]+σ1(w_mem[15]).
+  //----------------------------------------------------------------
+  always @*
+    begin : w_precomp_logic
+      reg [63 : 0] sig0_a;
+      reg [63 : 0] sig1_a;
+
+      sig0_a        = 64'h0;
+      sig1_a        = 64'h0;
+      w_precomp_new = 64'h0;
+
+      if (w_ctr_reg < 7'd15)
+        begin
+          // Rounds 0-14: next W is the next direct-read word W[ctr+1].
+          // Variable index only reaches w_precomp_reg (a register), not T1.
+          w_precomp_new = w_mem[w_ctr_reg[3 : 0] + 4'h1];
+        end
+      else if (w_ctr_reg == 7'd15)
+        begin
+          // Round 15: next W is the first expansion W[16].
+          sig0_a = {w_mem[1][0],     w_mem[1][63 : 1]} ^
+                   {w_mem[1][7 : 0], w_mem[1][63 : 8]} ^
+                   {7'b0000000,      w_mem[1][63 : 7]};
+          sig1_a = {w_mem[14][18 : 0], w_mem[14][63 : 19]} ^
+                   {w_mem[14][60 : 0], w_mem[14][63 : 61]} ^
+                   {6'b000000,         w_mem[14][63 : 6]};
+          w_precomp_new = w_mem[0] + sig0_a + w_mem[9] + sig1_a;
+        end
+      else
+        begin
+          // Rounds 16+: next W after one more slide, using fixed window indices.
+          sig0_a = {w_mem[2][0],     w_mem[2][63 : 1]} ^
+                   {w_mem[2][7 : 0], w_mem[2][63 : 8]} ^
+                   {7'b0000000,      w_mem[2][63 : 7]};
+          sig1_a = {w_mem[15][18 : 0], w_mem[15][63 : 19]} ^
+                   {w_mem[15][60 : 0], w_mem[15][63 : 61]} ^
+                   {6'b000000,         w_mem[15][63 : 6]};
+          w_precomp_new = w_mem[1] + sig0_a + w_mem[10] + sig1_a;
+        end
+    end // w_precomp_logic
