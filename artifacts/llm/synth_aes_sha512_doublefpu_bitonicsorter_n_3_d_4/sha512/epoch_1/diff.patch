+  //----------------------------------------------------------------
+  // w_prefetch_logic
+  //
+  // Compute the W value for the NEXT round one cycle early so
+  // w_out_reg is a registered value, breaking the expansion
+  // path from the critical path to the datapath registers.
+  //
+  // For rounds 0-14 : next word is w_mem[ctr+1] (direct read).
+  // For round 15    : next word is w_new from current state
+  //                   (no shift occurs this cycle).
+  // For rounds 16+  : next word uses the post-shift state:
+  //                   new[0]=old[1], new[1]=old[2],
+  //                   new[9]=old[10], new[14]=old[15].
+  // On init         : pre-load w[0] = block[1023:960] directly.
+  //----------------------------------------------------------------
+  always @*
+    begin : w_prefetch_logic
+      reg [63 : 0] d0_n;
+      reg [63 : 0] d1_n;
+
+      // σ0(w_mem[2]) and σ1(w_mem[15]) for post-shift expansion
+      d0_n = {w_mem[2][0],      w_mem[2][63 : 1]}  ^
+             {w_mem[2][7 : 0],  w_mem[2][63 : 8]}  ^
+             {7'b0000000,       w_mem[2][63 : 7]};
+
+      d1_n = {w_mem[15][18 : 0], w_mem[15][63 : 19]} ^
+             {w_mem[15][60 : 0], w_mem[15][63 : 61]} ^
+             {6'b000000,         w_mem[15][63 : 6]};
+
+      if (init)
+        w_prefetch = block[1023 : 960];
+      else if (next && (w_ctr_reg < 15))
+        w_prefetch = w_mem[w_ctr_reg[3 : 0] + 4'h1];
+      else if (next && (w_ctr_reg == 7'hf))
+        w_prefetch = w_new;
+      else if (next)
+        w_prefetch = w_mem[1] + d0_n + w_mem[10] + d1_n;
+      else
+        w_prefetch = w_out_reg;
+    end // w_prefetch_logic
 
 
   //----------------------------------------------------------------
